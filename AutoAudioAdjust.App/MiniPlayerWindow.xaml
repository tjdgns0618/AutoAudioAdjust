<Window x:Class="AutoAudioAdjust.App.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AAA 미니 플레이어"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Foreground="#F4F8FB">
    <!-- Tray flyout styled after the Windows media flyout: app row, song + artwork, transport buttons. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="Transport" TargetType="Button">
            <Setter Property="Foreground" Value="#EDF5FA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1D3046" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#24364B">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#D7E1EA"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#35D6B1" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="#071713" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Thin mint slider, same look as the main window -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="#35D6B1"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="#24364B"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="13" Height="13" Fill="#35D6B1" Stroke="#101D2E" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#101D2E" CornerRadius="14" BorderBrush="#2A4664" BorderThickness="1" Margin="10" Padding="18,14,18,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6" />
        </Border.Effect>
        <StackPanel>
            <!-- App row -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/AppIcon-256.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="AAA · Auto Audio Adjust" FontSize="12" Foreground="#B9C7D5" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Transport}" Width="28" Height="24" FontSize="11"
                            Content="&#xE8A7;" ToolTip="창 열기" Click="OpenButton_Click" />
                    <Button Style="{StaticResource Transport}" Width="28" Height="24" FontSize="11" Margin="2,0,0,0"
                            Content="&#xE8BB;" ToolTip="닫기" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Song + artwork -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TitleText" Text="재생 중인 곡 없음" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" Text="유튜브 뮤직에서 곡을 재생해 주세요" FontSize="12" Foreground="#91A3B8"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Width="72" Height="72" CornerRadius="8" Background="#0B1726" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                   Foreground="#2B425B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Seek bar: position / length -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Text="0:00" FontSize="11" Foreground="#91A3B8"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" IsEnabled="False"
                        SmallChange="5" LargeChange="10" Margin="4,0"
                        ValueChanged="SeekSlider_ValueChanged" />
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="11" Foreground="#91A3B8"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- Transport -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="PreviousButton" Style="{StaticResource Transport}" Content="&#xE892;" ToolTip="이전 곡"
                        Click="PreviousButton_Click" />
                <Button x:Name="PlayPauseButton" Style="{StaticResource Transport}" Content="&#xE768;" ToolTip="재생"
                        FontSize="20" Width="52" Margin="16,0" Click="PlayPauseButton_Click" />
                <Button x:Name="NextButton" Style="{StaticResource Transport}" Content="&#xE893;" ToolTip="다음 곡"
                        Click="NextButton_Click" />
            </StackPanel>

            <!-- YouTube Music volume -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MuteButton" Style="{StaticResource Transport}" Width="30" Height="28" FontSize="14"
                        Content="&#xE767;" ToolTip="유튜브 뮤직 음소거" IsEnabled="False" Click="MuteButton_Click" />
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" IsEnabled="False"
                        SmallChange="1" LargeChange="5" Margin="6,0" ToolTip="유튜브 뮤직 음량"
                        ValueChanged="VolumeSlider_ValueChanged" />
                <TextBlock x:Name="VolumeText" Grid.Column="2" Text="—%" FontSize="12" Foreground="#F4F8FB"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- Level + auto adjust -->
            <Border Height="1" Background="#1D3046" Margin="0,8,0,10" />
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#91A3B8">
                    <Run Text="듣는 크기" />
                    <Run x:Name="LevelRun" Text="—" Foreground="#F4F8FB" FontWeight="SemiBold" />
                    <Run Text="  ·  앱 볼륨" />
                    <Run x:Name="VolumeRun" Text="—%" Foreground="#F4F8FB" FontWeight="SemiBold" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="자동 보정" FontSize="12" Foreground="#91A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton x:Name="AutoToggle" Style="{StaticResource Switch}" Click="AutoToggle_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
