<Window x:Class="AutoAudioAdjust.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AAA · Auto Audio Adjust"
        Icon="Assets/AppIcon.ico"
        Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#08111F"
        Foreground="#F4F8FB">
    <!-- Layout ported from the Stitch design "AAA · Auto Audio Adjust" (top bar, embedded
         YouTube Music panel, right control column with four cards). -->
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#91A3B8" />
        <SolidColorBrush x:Key="FaintText" Color="#6F8399" />
        <SolidColorBrush x:Key="CardBackground" Color="#101D2E" />
        <SolidColorBrush x:Key="CardBorder" Color="#1D3046" />
        <SolidColorBrush x:Key="Inset" Color="#0B1726" />
        <SolidColorBrush x:Key="Accent" Color="#35D6B1" />
        <SolidColorBrush x:Key="AccentSoft" Color="#17352F" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2B40" />
            <Setter Property="Foreground" Value="#EDF5FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9C7D5" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- On/off switch for 자동 보정 -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="#24364B">
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#D7E1EA"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="#071713" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim dark scrollbar for the control column -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" CornerRadius="3" Background="#2B425B" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#3D5A78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin mint slider -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="{StaticResource Accent}" Stroke="#08111F" StrokeThickness="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource Accent}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="#24364B"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/AppIcon-256.png" Width="34" Height="34"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="AAA · Auto Audio Adjust" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,24,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="뒤로"
                        Click="BackButton_Click" IsEnabled="False" />
                <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="앞으로"
                        Click="ForwardButton_Click" IsEnabled="False" />
                <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="새로고침"
                        Click="ReloadButton_Click" />
                <Button x:Name="HomeButton" Style="{StaticResource IconButton}" Content="&#xE80F;" ToolTip="유튜브 뮤직 홈"
                        Click="HomeButton_Click" />
                <Border Background="{StaticResource Inset}" CornerRadius="9" Padding="10,5" Margin="8,0,0,0"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource FaintText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="music.youtube.com" FontSize="12" Foreground="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border Grid.Column="3" x:Name="StatusPill" Background="#19283A" CornerRadius="13" Padding="12,6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#718096" Margin="0,0,8,0" />
                    <TextBlock x:Name="HeaderStatusText" Text="대기 중" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Embedded YouTube Music -->
        <Border Grid.Row="2" Grid.Column="0" Background="#030A14" CornerRadius="16" Padding="6"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#030A14" />
                <StackPanel x:Name="BrowserPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#FF5C5C" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                    </Border>
                    <TextBlock Text="YouTube Music" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="BrowserPlaceholderText" Text="불러오는 중..." Foreground="{StaticResource MutedText}"
                               FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right control column -->
        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 현재 음량 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="현재 음량" Style="{StaticResource CardTitle}" />
                            <Border Style="{StaticResource Badge}">
                                <TextBlock Text="● LIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBlock FontFamily="Cascadia Mono, Consolas, Segoe UI">
                                <Run x:Name="CurrentLevelText" Text="—" FontSize="30" FontWeight="Bold" />
                                <Run Text=" / 100" FontSize="13" Foreground="{StaticResource FaintText}" />
                            </TextBlock>
                            <TextBlock x:Name="CurrentDbText" Text="— dB RMS" Foreground="{StaticResource FaintText}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </Grid>
                        <Grid x:Name="LevelTrack" Height="10" Margin="0,10,0,0">
                            <Border CornerRadius="5" Background="#081321" BorderBrush="#2B425B" BorderThickness="1" />
                            <Border x:Name="LevelMeter" CornerRadius="5" HorizontalAlignment="Left" Width="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1E7F6A" Offset="0" />
                                        <GradientStop Color="#35D6B1" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle x:Name="TargetMarker" Width="2" Fill="White" HorizontalAlignment="Left"
                                       Margin="0,-3" ToolTip="목표 음량" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="0" Foreground="{StaticResource FaintText}" FontSize="10" />
                            <TextBlock Text="50" Foreground="{StaticResource FaintText}" FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock Text="100" Foreground="{StaticResource FaintText}" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 자동 보정 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="자동 보정" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            <ToggleButton x:Name="AutoToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          Checked="AutoToggle_Changed" Unchecked="AutoToggle_Changed" />
                        </Grid>
                        <TextBlock x:Name="AutoStatusText" Text="재생을 기다리는 중" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="AutoDetailText" Text="유튜브 뮤직에서 곡을 재생하면 자동으로 보정합니다."
                                   Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 볼륨 조절 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="볼륨 조절" Style="{StaticResource CardTitle}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedText}" VerticalAlignment="Center">
                                <Run Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF5C5C" />
                                <Run Text=" 유튜브 뮤직" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" x:Name="YtmVolumeText" Text="—%" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Grid.Column="2" x:Name="YtmMuteButton" Style="{StaticResource IconButton}"
                                    Width="28" Height="28" Content="&#xE767;" ToolTip="유튜브 뮤직 음소거"
                                    Click="YtmMuteButton_Click" IsEnabled="False" />
                        </Grid>
                        <Slider x:Name="YtmVolumeSlider" Minimum="0" Maximum="100" Value="100" SmallChange="1" LargeChange="5"
                                ValueChanged="YtmVolumeSlider_ValueChanged" IsEnabled="False" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedText}" VerticalAlignment="Center">
                                <Run Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#35D6B1" />
                                <Run Text=" 앱 볼륨 (Windows)" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" x:Name="CurrentVolumeText" Text="—%" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Grid.Column="2" x:Name="AppMuteButton" Style="{StaticResource IconButton}"
                                    Width="28" Height="28" Content="&#xE767;" ToolTip="앱 음소거"
                                    Click="AppMuteButton_Click" IsEnabled="False" />
                        </Grid>
                        <Slider x:Name="AppVolumeSlider" Minimum="0" Maximum="100" Value="100" SmallChange="1" LargeChange="5"
                                ValueChanged="AppVolumeSlider_ValueChanged" IsEnabled="False" />
                        <TextBlock x:Name="AppVolumeHint" Text="자동 보정이 켜져 있으면 앱 볼륨은 자동으로 조절됩니다. 유튜브 뮤직 볼륨은 목표 크기 위에 그대로 적용됩니다."
                                   Foreground="{StaticResource FaintText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 목표 음량 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="목표 음량" Style="{StaticResource CardTitle}" />
                            <Border Style="{StaticResource Badge}">
                                <TextBlock x:Name="TargetLevelText" Text="82" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource Accent}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="어떤 곡이든 이 크기로 맞춥니다 (0 가장 작게 · 100 가장 크게)"
                                   Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <Slider x:Name="TargetSlider" Minimum="0" Maximum="100" Value="82" SmallChange="1" LargeChange="5"
                                Margin="0,10,0,0" ValueChanged="SettingsSlider_ValueChanged" />
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="더 작게" Foreground="{StaticResource FaintText}" FontSize="11" />
                            <TextBlock x:Name="TargetDbText" Text="-28 dB" Foreground="{StaticResource FaintText}" FontSize="11"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="더 크게" HorizontalAlignment="Right" Foreground="{StaticResource FaintText}" FontSize="11" />
                        </Grid>
                        <Button x:Name="CalibrateButton" Margin="0,12,0,0" Click="CalibrateButton_Click" IsEnabled="False">
                            <TextBlock>
                                <Run Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#35D6B1" />
                                <Run Text=" 현재 음량을 기준으로" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 안전 범위 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="안전 범위" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="자동 보정이 움직일 수 있는 플레이어 볼륨 범위"
                                   Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <Grid>
                            <TextBlock Text="최소 볼륨" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBlock x:Name="MinVolumeText" Text="10%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="MinVolumeSlider" Minimum="0" Maximum="80" Value="10" SmallChange="1" LargeChange="5"
                                ValueChanged="SettingsSlider_ValueChanged" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Text="최대 볼륨" FontSize="12" Foreground="{StaticResource MutedText}" />
                            <TextBlock x:Name="MaxVolumeText" Text="85%" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="MaxVolumeSlider" Minimum="20" Maximum="100" Value="85" SmallChange="1" LargeChange="5"
                                ValueChanged="SettingsSlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource FaintText}" FontSize="11" Margin="0,2,0,0">
                    <Run Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    <Run Text=" 오디오는 이 PC 안에서만 처리됩니다" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
