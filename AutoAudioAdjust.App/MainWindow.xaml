<Window x:Class="AutoAudioAdjust.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AAA · Auto Audio Adjust"
        Width="980" Height="700" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#08111F"
        Foreground="#F4F8FB">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#91A3B8" />
        <SolidColorBrush x:Key="CardBackground" Color="#101D2E" />
        <SolidColorBrush x:Key="Accent" Color="#35D6B1" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderBrush" Value="#1D3046" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A2B40" />
            <Setter Property="Foreground" Value="#EDF5FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#071713" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="28,14" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0B1726" />
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBackground" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#1A3A3A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background" Value="#24584F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1726" />
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="BorderBrush" Value="#35506C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="SelectionBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" />
                            <ContentPresenter Margin="12,0,42,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="#F4F8FB"
                                              IsHitTestVisible="False" />
                            <ToggleButton x:Name="DropDownButton" Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="#16283B"
                                                    HorizontalAlignment="Right" Margin="0,0,6,0">
                                                <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0" Stroke="#B9C7D5"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Stroke" Value="#35D6B1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#0B1726" BorderBrush="#35506C" BorderThickness="1"
                                        CornerRadius="10" Margin="0,5,0,0" Padding="2"
                                        MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectionBackground" Property="BorderBrush" Value="#35D6B1" />
                                <Setter TargetName="SelectionBackground" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="SelectionBackground" Property="Background" Value="#102237" />
                                <Setter TargetName="SelectionBackground" Property="BorderBrush" Value="#35D6B1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
    </Window.Resources>

    <Grid Margin="38,30,38,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="14" Background="#17352F">
                    <TextBlock Text="≋" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="Auto Audio Adjust" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="곡이 바뀌어도 편안한 음량을 유지합니다" Foreground="{StaticResource MutedText}" FontSize="13" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" x:Name="StatusPill" Background="#19283A" CornerRadius="14" Padding="13,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#718096" Margin="0,0,8,0" />
                    <TextBlock x:Name="HeaderStatusText" Text="대기 중" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.RowSpan="3" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="재생 앱" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="유튜브 뮤직을 재생한 뒤 브라우저 또는 PWA를 선택하세요."
                                   Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SessionComboBox" DisplayMemberPath="DisplayName" SelectionChanged="SessionComboBox_SelectionChanged" />
                        <Button Grid.Column="2" Content="새로고침" Click="RefreshButton_Click" />
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="현재 감지 음량" Foreground="{StaticResource MutedText}" FontSize="12" />
                            <TextBlock x:Name="CurrentLevelText" Text="— dB" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                        <Border Height="12" CornerRadius="6" Background="#081321" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="LevelMeter" HorizontalAlignment="Left" Fill="{StaticResource Accent}" Width="0" />
                                <Border BorderBrush="#2B425B" BorderThickness="1" CornerRadius="6" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="앱 볼륨" Foreground="{StaticResource MutedText}" FontSize="12" />
                            <TextBlock x:Name="CurrentVolumeText" Text="—%" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="6" Background="#0B1726" CornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="TIP" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text="처음에는 좋아하는 곡을 틀고 ‘현재 음량을 기준으로’를 눌러 보세요. 이후 다른 곡부터 자동 보정됩니다."
                                       Foreground="#B9C7D5" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="목표 음량" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="체감 음량의 기준점" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TargetLevelText" Text="-18 dB" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Foreground="{StaticResource Accent}" FontSize="24" FontWeight="Bold" />
                    </Grid>
                    <Slider x:Name="TargetSlider" Minimum="-30" Maximum="-8" Value="-18" TickFrequency="1"
                            Margin="0,20,0,0" ValueChanged="SettingsSlider_ValueChanged" />
                    <Grid Margin="2,3,2,0">
                        <TextBlock Text="더 작게" Foreground="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Text="더 크게" HorizontalAlignment="Right" Foreground="{StaticResource MutedText}" FontSize="11" />
                    </Grid>
                    <Button x:Name="CalibrateButton" Content="현재 음량을 기준으로" Margin="0,16,0,0"
                            Click="CalibrateButton_Click" IsEnabled="False" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="안전 범위" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="자동 보정이 움직일 수 있는 앱 볼륨 범위입니다."
                               Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,18" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="최소 볼륨" FontSize="12" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="MinVolumeText" Text="10%" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="MinVolumeSlider" Minimum="0" Maximum="80" Value="10" TickFrequency="5"
                            ValueChanged="SettingsSlider_ValueChanged" />
                    <Grid Margin="0,14,0,4">
                        <TextBlock Text="최대 볼륨" FontSize="12" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="MaxVolumeText" Text="85%" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="MaxVolumeSlider" Minimum="20" Maximum="100" Value="85" TickFrequency="5"
                            ValueChanged="SettingsSlider_ValueChanged" />
                    <TextBlock Text="큰 소리는 빠르게, 작은 소리는 천천히 보정하여 갑작스러운 변화와 펌핑을 줄입니다."
                               Foreground="#7F93A8" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="17" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FooterStatusText" Text="재생 앱을 선택해 주세요" FontWeight="SemiBold" FontSize="13" />
                <TextBlock x:Name="FooterDetailText" Text="오디오 데이터는 이 PC 안에서만 처리됩니다."
                           Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="ToggleButton" Content="자동 보정 시작" Style="{StaticResource PrimaryButton}"
                    Click="ToggleButton_Click" IsEnabled="False" MinWidth="168" />
        </Grid>
    </Grid>
</Window>
