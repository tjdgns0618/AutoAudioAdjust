<Window x:Class="AutoAudioAdjust.App.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AAA · Auto Audio Adjust"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#F4F8FB">
    <Border Background="#101D2E" CornerRadius="16" BorderBrush="#2A4664" BorderThickness="1" Padding="24,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe UI" />
                </Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#EDF5FA" />
                    <Setter Property="Background" Value="#1A2B40" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="16,10" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Opacity" Value="0.82" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/AppIcon-256.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="앱을 닫을까요?" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="트레이로 보내면 창만 숨기고 음악과 자동 보정은 계속됩니다. 작업 표시줄 오른쪽 아이콘을 더블클릭하면 다시 열립니다."
                       Foreground="#91A3B8" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,12,0,0" />

            <CheckBox x:Name="RememberCheckBox" Margin="0,16,0,0" Foreground="#B9C7D5" FontSize="12" Cursor="Hand">
                <TextBlock Text="다음부터 묻지 않기 (트레이 메뉴에서 다시 켤 수 있습니다)" TextWrapping="Wrap" />
            </CheckBox>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ExitButton" Content="종료" Click="ExitButton_Click" />
                <Button Grid.Column="2" x:Name="TrayButton" Content="트레이로 보내기" Background="#35D6B1" Foreground="#071713"
                        Click="TrayButton_Click" IsDefault="True" />
            </Grid>
            <TextBlock Text="Esc: 취소" Foreground="#6F8399" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</Window>
